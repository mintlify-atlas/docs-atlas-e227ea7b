  "keyFeatures": [
    "Swipe-based user discovery with filters (distance, age, gender, interests)",
    "Real-time messaging over Socket.io with read receipts",
    "WebRTC-powered audio and video calls between matched users",
    "Facial recognition verification using live camera capture",
    "Automated restaurant date suggestions after 5 messages",
    "Social login via Google and Facebook OAuth",
    "Partner (restaurant/business) portal with menu and booking management",
    "Web-based admin panel with user management, analytics, and moderation tools",
    "Dual light/dark theme support with branded color tokens",
    "Expo-based cross-platform mobile app (iOS + Android)"
  ],
